## Ignore Visual Studio temporary files, build results, and
## files generated by popular Umbraco / .NET tools.

###################
# Build results
###################
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
artifacts/

###################
# Visual Studio / Rider / VS Code
###################
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

###################
# NuGet
###################
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

###################
# OS files
###################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

###################
# Test / coverage
###################
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

###################
# Umbraco
###################
**/umbraco/Data/
**/umbraco/Logs/
**/App_Data/
**/App_Plugins/ModelsBuilder/
**/wwwroot/media/
**/wwwroot/umbraco/
**/Models/Generated/
**/uSync/TEMP/

# Local SQLite databases and locks
*.sqlite.db
*.sqlite.db-shm
*.sqlite.db-wal

# Secrets and environment-specific overrides (keep Development without secrets)
**/appsettings.*.local.json
**/appsettings.Production.json
**/secrets.json
.env
.env.*

# Temporary publish output used in demos
/publish/

# Schema files copied into the test project via the web project reference
tests/**/appsettings-schema*.json
tests/**/umbraco-package-schema.json
